# Base URL of the Backgammon Coach API (see /backend). Leave empty to hide cloud backup.
EXPO_PUBLIC_API_URL=
# RevenueCat public SDK keys (Project settings → API keys). Without one, release builds show
# "Premium isn't on sale in this version yet" and development builds use the simulated store.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Development builds only: set to "mock" to use the simulated store even when a key is set.
EXPO_PUBLIC_STORE=
# PostHog project API key (public) and host (https://eu.i.posthog.com for EU hosting).
# Without a key, analytics stay on the device.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
# Sentry DSN (Project settings → Client Keys). Public; without one, crashes aren't reported.
EXPO_PUBLIC_SENTRY_DSN=
# Set by eas.json per build profile (development / preview / production); leave unset locally.
# EXPO_PUBLIC_APP_VARIANT=
#
# Build-time only (EAS environment variables, not EXPO_PUBLIC_): upload source maps and debug
# symbols so crash reports are readable. SENTRY_AUTH_TOKEN must be a secret.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
