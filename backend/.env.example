# Port the API listens on.
PORT=3000
# MongoDB connection string. Without it the API keeps data in memory (development only).
MONGODB_URI=
MONGODB_DB=backgammon_coach
# Comma-separated origins allowed to call the API from a browser (the web build). Native apps don't need this.
CORS_ORIGINS=http://localhost:8081
# Number of proxies in front of the API (a hosting platform's load balancer is usually 1),
# so rate limits apply per client instead of per proxy. Leave empty when clients connect directly.
TRUST_PROXY=
# NODE_ENV=production makes MONGODB_URI required.
